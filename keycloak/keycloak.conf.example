# Stable, non-secret Keycloak settings. Environment variables in .env override
# these values when run-prod.ps1 starts the server.
db=mssql
http-enabled=false
https-port=8180
health-enabled=true
metrics-enabled=false

# Keycloak runs behind the VPN without a reverse proxy. Set KC_HOSTNAME in .env
# to the URL used by VPN clients, for example https://drevi-pc:8180.
