# Keycloak connects to a dedicated database on the existing SQL Server.
KC_DB=mssql
KC_DB_URL_HOST=localhost
KC_DB_URL_PORT=1433
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=replace_with_a_strong_password
# Keep encryption enabled. Set trustServerCertificate=true only when SQL Server
# uses a certificate that this Windows machine cannot validate.
KC_DB_URL_PROPERTIES=;encrypt=true;trustServerCertificate=false

# Use the hostname or VPN address that clients actually use.
KC_HTTP_ENABLED=false
KC_HTTPS_PORT=8180
KC_HTTPS_CERTIFICATE_FILE=../../certs/bureaucracy.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=../../certs/bureaucracy.key
KC_HOSTNAME=https://drevi-pc:8180

# These values create the first administrator on an empty Keycloak database.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_admin_password
