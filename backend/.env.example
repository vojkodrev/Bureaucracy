APP_NAME=bureaucracy-backend
APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGIN=https://localhost:5173,https://localhost:4173,https://drevi-pc:4173
TLS_CERT_FILE=../certs/bureaucracy.crt
TLS_KEY_FILE=../certs/bureaucracy.key
KEYCLOAK_URL=https://localhost:8180
KEYCLOAK_REALM=bureaucracy
KEYCLOAK_CLIENT_ID=bureaucracy-frontend
KEYCLOAK_CA_CERT_FILE=../certs/bureaucracy-ca.crt

MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=master
MSSQL_USERNAME=your_username
MSSQL_PASSWORD=your_password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# Outgoing invoice email. SMTP_SECURITY supports starttls, tls, or none.
SMTP_HOST=mail.siol.net
SMTP_PORT=465
SMTP_USERNAME=username
SMTP_PASSWORD=password
SMTP_FROM_ADDRESS="Drevi d.o.o. <drev@siol.net>"
SMTP_SECURITY=tls
