scalar Time

type BusinessYear {
  code: String
  description: String
  year: Int
  derivedFrom: String
}

type BusinessYearPage {
  businessYears: [BusinessYear!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Customer {
  id: Int!
  customerId: String
  name: String
  address: String
  postalCode: String
  city: String
  country: String
  contact: String
  email: String
  phone: String
  taxNumber: String
  registrationNumber: String
  iban: String
  bic: String
  paymentTerm: Int
  discount: Float
}

type CustomerPage {
  customers: [Customer!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Country {
  id: Int!
  code: String!
  name: String!
}

type BankStatementEntry {
  id: Int!
  statementId: Int!
  statementNumber: Int
  paymentDate: Time
  customerId: String
  customerName: String
  transactionType: String
  transactionTypeId: Int
  outflow: Float
  inflow: Float
  documentNumber: String
  reference: String
  purpose: String
}

type BankStatement {
  id: Int!
  statementNumber: Int
  statementDate: Time
  bankAccount: String
  entries: [BankStatementEntry!]!
}

type BankTransactionType {
  id: Int!
  code: Int
  name: String
  direction: String
}

input BankStatementEntryInput {
  id: Int
  customerId: String
  customerName: String
  transactionTypeId: Int
  outflow: Float
  inflow: Float
  documentNumber: String
  reference: String
  purpose: String
}

input BankStatementInput {
  id: Int
  statementNumber: Int!
  statementDate: Time!
  bankAccount: String!
  entries: [BankStatementEntryInput!]!
}

type BankAccount {
  id: Int!
  code: String!
  name: String
  accountNumber: String
}

type BankStatementPage {
  entries: [BankStatementEntry!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

input CustomerInput {
  id: Int
  customerId: String!
  name: String
  address: String
  postalCode: String
  city: String
  country: String
  contact: String
  email: String
  phone: String
  taxNumber: String
  registrationNumber: String
  iban: String
  bic: String
  paymentTerm: Int
  discount: Float
}

type Invoice {
  id: Int!
  invoiceNumber: String!
  issueDate: Time
  serviceDate: Time
  dueDate: Time
  paymentDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerPostalCode: String
  customerCity: String
  customerCountry: String
  customerContact: String
  currency: String
  amount: Float
  goodsAmount: Float
  paidAmount: Float
  purchaseOrderNumber: String
  deliveryNoteNumber: String
  paymentReference: String
  introductoryText: String
  closingText: String
  cancelled: Boolean
  items: [InvoiceItem!]!
}

type InvoiceItem {
  id: Int!
  sequence: Int
  productCode: String
  productName: String
  unit: String
  taxCode: String
  taxRate: Float
  unitPrice: Float
  unitTaxAmount: Float
  quantity: Float
  discount: Float
  netAmount: Float
  grossAmount: Float
}

type InvoicePage {
  invoices: [Invoice!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type PriceQuote {
  id: Int!
  quoteNumber: String!
  issueDate: Time
  dueDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerPostalCode: String
  customerCity: String
  customerCountry: String
  currency: String
  amount: Float
  introductoryText: String
  closingText: String
  items: [InvoiceItem!]!
}

type PriceQuotePage {
  priceQuotes: [PriceQuote!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type PriceQuoteTextTemplate {
  introductoryText: String
  closingText: String
}

input PriceQuoteItemInput {
  id: Int
  sequence: Int
  productCode: String!
  taxCode: String!
  quantity: Float
  discount: Float
  netAmount: Float
  grossAmount: Float
}

input PriceQuoteInput {
  id: Int
  quoteNumber: String!
  issueDate: Time
  dueDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerCity: String
  introductoryText: String
  closingText: String
  items: [PriceQuoteItemInput!]!
}

type InvoiceCustomerSummary {
  customerCode: String
  customerName: String
  invoices: [Invoice!]!
  totalPaid: Float!
  totalOutstanding: Float!
  totalOverdue: Float!
  totalInvoiced: Float!
}

type InvoiceCustomerSummaryPage {
  customerSummaries: [InvoiceCustomerSummary!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type InvoiceTextTemplate {
  introductoryText: String
  closingText: String
}

input InvoiceItemInput {
  id: Int
  sequence: Int
  productCode: String!
  taxCode: String!
  quantity: Float
  discount: Float
  netAmount: Float
  grossAmount: Float
}

type TaxCode {
  id: Int!
  code: String!
  description: String
  rate: Float
}

input InvoiceInput {
  id: Int
  invoiceNumber: String!
  issueDate: Time
  serviceDate: Time
  dueDate: Time
  paymentDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerCity: String
  paidAmount: Float
  purchaseOrderNumber: String
  deliveryNoteNumber: String
  introductoryText: String
  closingText: String
  items: [InvoiceItemInput!]!
}

type Product {
  id: Int!
  productCode: String
  name: String
  barcode: String
  unit: String
  netPrice: Float
  grossPrice: Float
  taxRate: Float
  taxCode: String
}

type ProductInvoiceCount {
  productCode: String!
  invoiceCount: Int!
}

type ProductPage {
  products: [Product!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type InventoryItem {
  id: Int!
  productCode: String
  name: String
  unit: String
  minimumStockLevel: Float
}

type InventoryItemPage {
  items: [InventoryItem!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

input ProductInput {
  id: Int
  productCode: String!
  name: String
  unit: String
  netPrice: Float
  grossPrice: Float
  taxRate: Float
  taxCode: String
}

type Query {

  searchBankStatements(
    businessYear: String!
    dateFrom: Time
    dateTo: Time
    statementNumber: Int
    bankAccount: String
    customerId: String
    customerName: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): BankStatementPage!

  bankAccounts(businessYear: String!): [BankAccount!]!
  bankTransactionTypes(businessYear: String!): [BankTransactionType!]!
  bankStatement(businessYear: String!, statementNumber: Int!): BankStatement
  latestBankStatementNumber(businessYear: String!, bankAccount: String): Int
  businessYear(code: String!): BusinessYear
  currentBusinessYear: BusinessYear

  businessYears(
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): BusinessYearPage!

  countries(businessYear: String!): [Country!]!

  invoice(
    businessYear: String!
    invoiceNumber: String!
  ): Invoice

  invoiceTextTemplate(businessYear: String!): InvoiceTextTemplate!

  priceQuote(businessYear: String!, quoteNumber: String!): PriceQuote

  priceQuoteTextTemplate(businessYear: String!): PriceQuoteTextTemplate!

  product(
    businessYear: String!
    productCode: String!
  ): Product

  customer(
    businessYear: String!
    customerId: String!
  ): Customer

  searchCustomers(
    businessYear: String!
    customerId: String
    customerName: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): CustomerPage!

  searchInvoices(
    businessYear: String!
    invoiceNumber: String
    customerId: String
    customerName: String
    productCode: String
    productName: String
    issuedFrom: Time
    issuedTo: Time
    paymentStatus: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): InvoicePage!

  searchInvoicesByCustomer(
    businessYear: String!
    invoiceNumber: String
    customerId: String
    customerName: String
    productCode: String
    productName: String
    issuedFrom: Time
    issuedTo: Time
    paymentStatus: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): InvoiceCustomerSummaryPage!

  searchPriceQuotes(
    businessYear: String!
    quoteNumber: String
    customerId: String
    customerName: String
    productCode: String
    productName: String
    issuedFrom: Time
    issuedTo: Time
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): PriceQuotePage!

  searchProducts(
    businessYear: String!
    productCode: String
    productName: String
    similarName: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): ProductPage!

  searchInventoryItems(
    businessYear: String!
    productCode: String
    productName: String
    similarName: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): InventoryItemPage!

  productInvoiceCounts(
    businessYear: String!
    productCodes: [String!]!
  ): [ProductInvoiceCount!]!

  taxCodes(businessYear: String!): [TaxCode!]!
}

type Mutation {
  saveBankStatement(businessYear: String!, statement: BankStatementInput!): BankStatement!
  saveCustomer(businessYear: String!, customer: CustomerInput!): Customer!
  updateCustomerEmail(businessYear: String!, customerId: String!, email: String!): Customer!
  saveInvoice(businessYear: String!, invoice: InvoiceInput!): Invoice!
  savePriceQuote(businessYear: String!, priceQuote: PriceQuoteInput!): PriceQuote!
  saveProduct(businessYear: String!, product: ProductInput!): Product!
}
