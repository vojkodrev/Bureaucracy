scalar Time

type BusinessYear {
  code: String
  description: String
  year: Int
  derivedFrom: String
}

type BusinessYearPage {
  businessYears: [BusinessYear!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Invoice {
  id: Int!
  invoiceNumber: String!
  issueDate: Time
  serviceDate: Time
  dueDate: Time
  paymentDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerCity: String
  customerContact: String
  currency: String
  amount: Float
  goodsAmount: Float
  paidAmount: Float
  paymentReference: String
  cancelled: Boolean
}

type InvoicePage {
  invoices: [Invoice!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Query {
  businessYears(
    page: Int = 1
    pageSize: Int = 20
  ): BusinessYearPage!

  searchInvoices(
    invoiceNumber: String
    customerId: String
    customerName: String
    issuedFrom: Time
    issuedTo: Time
    page: Int = 1
    pageSize: Int = 20
  ): InvoicePage!
}
