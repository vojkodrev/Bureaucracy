scalar Time

type BusinessYear {
  code: String
  description: String
  year: Int
  derivedFrom: String
}

type BusinessYearPage {
  businessYears: [BusinessYear!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Customer {
  id: Int!
  customerId: String
  name: String
  address: String
  postalCode: String
  city: String
  country: String
  contact: String
  email: String
  phone: String
  taxNumber: String
  registrationNumber: String
  paymentTerm: Int
  discount: Float
}

type CustomerPage {
  customers: [Customer!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Invoice {
  id: Int!
  invoiceNumber: String!
  issueDate: Time
  serviceDate: Time
  dueDate: Time
  paymentDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerPostalCode: String
  customerCity: String
  customerCountry: String
  customerContact: String
  currency: String
  amount: Float
  goodsAmount: Float
  paidAmount: Float
  paymentReference: String
  cancelled: Boolean
  items: [InvoiceItem!]!
}

type InvoiceItem {
  id: Int!
  sequence: Int
  productCode: String
  productName: String
  unit: String
  quantity: Float
  discount: Float
  taxCode: String
  netAmount: Float
  grossAmount: Float
}

type InvoicePage {
  invoices: [Invoice!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Product {
  id: Int!
  productCode: String
  name: String
  barcode: String
  unit: String
  netPrice: Float
  grossPrice: Float
  taxRate: Float
  taxCode: String
}

type ProductPage {
  products: [Product!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Query {
  businessYears(
    page: Int = 1
    pageSize: Int = 20
  ): BusinessYearPage!

  invoice(
    businessYear: String!
    invoiceNumber: String!
  ): Invoice

  searchCustomers(
    businessYear: String!
    customerId: String
    customerName: String
    page: Int = 1
    pageSize: Int = 20
  ): CustomerPage!

  searchInvoices(
    businessYear: String!
    invoiceNumber: String
    customerId: String
    customerName: String
    issuedFrom: Time
    issuedTo: Time
    page: Int = 1
    pageSize: Int = 20
  ): InvoicePage!

  searchProducts(
    businessYear: String!
    productCode: String
    productName: String
    page: Int = 1
    pageSize: Int = 20
  ): ProductPage!
}
