scalar Time

type BusinessYear {
  code: String
  description: String
  year: Int
  derivedFrom: String
}

type BusinessYearPage {
  businessYears: [BusinessYear!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Customer {
  id: Int!
  customerId: String
  name: String
  address: String
  postalCode: String
  city: String
  country: String
  contact: String
  email: String
  phone: String
  taxNumber: String
  registrationNumber: String
  paymentTerm: Int
  discount: Float
}

type CustomerPage {
  customers: [Customer!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

input CustomerInput {
  id: Int
  customerId: String!
  name: String
  address: String
  postalCode: String
  city: String
  country: String
  contact: String
  email: String
  phone: String
  taxNumber: String
  registrationNumber: String
  paymentTerm: Int
  discount: Float
}

type Invoice {
  id: Int!
  invoiceNumber: String!
  issueDate: Time
  serviceDate: Time
  dueDate: Time
  paymentDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerPostalCode: String
  customerCity: String
  customerCountry: String
  customerContact: String
  currency: String
  amount: Float
  goodsAmount: Float
  paidAmount: Float
  paymentReference: String
  introductoryText: String
  closingText: String
  cancelled: Boolean
  items: [InvoiceItem!]!
}

type InvoiceItem {
  id: Int!
  sequence: Int
  productCode: String
  productName: String
  unit: String
  taxCode: String
  taxRate: Float
  unitPrice: Float
  unitTaxAmount: Float
  quantity: Float
  discount: Float
  netAmount: Float
  grossAmount: Float
}

type InvoicePage {
  invoices: [Invoice!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

input InvoiceItemInput {
  id: Int
  sequence: Int
  productCode: String!
  taxCode: String!
  quantity: Float
  discount: Float
  netAmount: Float
  grossAmount: Float
}

type TaxCode {
  id: Int!
  code: String!
  description: String
  rate: Float
}

input InvoiceInput {
  id: Int
  invoiceNumber: String!
  issueDate: Time
  serviceDate: Time
  paymentDate: Time
  customerCode: String
  customerName: String
  customerAddress: String
  customerCity: String
  paidAmount: Float
  introductoryText: String
  closingText: String
  items: [InvoiceItemInput!]!
}

type Product {
  id: Int!
  productCode: String
  name: String
  barcode: String
  unit: String
  netPrice: Float
  grossPrice: Float
  taxRate: Float
  taxCode: String
}

type ProductPage {
  products: [Product!]!
  totalCount: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

input ProductInput {
  id: Int
  productCode: String!
  name: String
  unit: String
  netPrice: Float
  grossPrice: Float
  taxRate: Float
  taxCode: String
}

type Query {
  businessYear(code: String!): BusinessYear

  businessYears(
    page: Int = 1
    pageSize: Int = 20
  ): BusinessYearPage!

  invoice(
    businessYear: String!
    invoiceNumber: String!
  ): Invoice

  product(
    businessYear: String!
    productCode: String!
  ): Product

  customer(
    businessYear: String!
    customerId: String!
  ): Customer

  searchCustomers(
    businessYear: String!
    customerId: String
    customerName: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): CustomerPage!

  searchInvoices(
    businessYear: String!
    invoiceNumber: String
    customerId: String
    customerName: String
    issuedFrom: Time
    issuedTo: Time
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): InvoicePage!

  searchProducts(
    businessYear: String!
    productCode: String
    productName: String
    sortBy: String
    sortDirection: String
    page: Int = 1
    pageSize: Int = 20
  ): ProductPage!

  taxCodes(businessYear: String!): [TaxCode!]!
}

type Mutation {
  saveCustomer(businessYear: String!, customer: CustomerInput!): Customer!
  saveInvoice(businessYear: String!, invoice: InvoiceInput!): Invoice!
  saveProduct(businessYear: String!, product: ProductInput!): Product!
}
