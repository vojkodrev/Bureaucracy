MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=Birokrat
MSSQL_USERNAME=your_username
MSSQL_PASSWORD=your_password
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=no

# Training data and snapshot rules.
TRAINING_START_DATE=2004-01-01
TRAINING_END_DATE=
WARMUP_MONTHS=12
CUTOFF_INTERVAL_DAYS=7
ACTIVE_PAIR_MONTHS=24

# Model output and CatBoost settings.
MODEL_DIRECTORY=models
MODEL_ITERATIONS=500
MODEL_LEARNING_RATE=0.05
MODEL_DEPTH=7
MODEL_RANDOM_SEED=42

