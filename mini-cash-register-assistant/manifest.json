{
    "manifest_version": 3,
    "name": "Mini Cash Register Assistant",
    "version": "0.1.0",
    "description": "Assists with reporting VKR invoices in Mini Blagajna.",
    "key": "",
    "permissions": ["identity", "storage"],
    "host_permissions": ["https://drevi-pc:8080/*", "https://drevi-pc:8180/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Mini Cash Register Assistant",
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://miniblagajna.fu.gov.si/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
